        "ITT = smf.ols('endline_income ~ farms_trt', data=df).fit().params['farms_trt']\n",
        "compliance = df[df['farms_trt']==1]['farms_got_loan'].mean()\n",
        "LATE = ITT / compliance\n",
        "print(f\"ITT: {ITT:.3f}\")\n",
        "print(f\"Compliance rate: {compliance:.3f}\")\n",
